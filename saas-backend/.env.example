# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_erp?schema=public"

# CORS configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5172,http://localhost:5173"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Default Super Admin Seed Credentials
INITIAL_SUPERADMIN_NAME="Alex Sterling"
INITIAL_SUPERADMIN_EMAIL="alex.sterling@edusaas.io"
INITIAL_SUPERADMIN_PASSWORD="SuperAdmin@2026"
